# Set default behavior to automatically normalize line endings
* text=auto

# Ensure SQL, Python, JavaScript, and Markdown files use LF in repo
*.py text eol=lf
*.sql text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pbix binary
